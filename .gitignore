TestServer/config/pch_system_config.json

# 本地临时文件（如 ./Run 测试产物）
/Run
/tempt/
.mcp.json

# Docker Compose 本地 override（含机器特定绝对路径，勿提交）
docker-compose.override.yml

# PCHSystem 部署脚本产物（由 Scripts/install.sh + update.sh 生成）
.pchsystem.deploy.env
backups/
# Claude worktrees（本地 git worktree 检出，含机器绝对路径与大量文件，勿入库）
.claude/worktrees/

# e2e 测试截图（MCP 浏览器验证产物，PNG 格式，本地调试用，勿入库）
.e2e-screenshots/

